# ---------------------------------------------------------------------------
# howitsgoing — environment variables
# `npm run dev` auto-generates BETTER_AUTH_SECRET / ENCRYPTION_KEY into
# .env.local if they are missing. Everything else is optional locally.
# ---------------------------------------------------------------------------

# Public URL of the app (used for auth callbacks). On Vercel this is derived
# automatically from the production domain, so you can leave it unset there.
BETTER_AUTH_URL=http://localhost:3000

# Signing secret for sessions. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# 32-byte key used to encrypt Stripe/PostHog/... credentials at rest.
# `openssl rand -hex 32`. Required in production; never rotate it casually,
# or existing connections can no longer be decrypted.
ENCRYPTION_KEY=

# Database. Local SQLite by default. In production use a Turso/libSQL URL:
#   DATABASE_URL=libsql://howitsgoing-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
# Vercel's Turso marketplace integration instead injects TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN, which are picked up automatically.
DATABASE_URL=file:./data/howitsgoing.db
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional: "Sign in with GitHub". Create an OAuth app at
# https://github.com/settings/developers with callback URL
#   <public URL>/api/auth/callback/github
# e.g. https://howitsgoing.vercel.app/api/auth/callback/github
# Without these, email + password sign-in is used (and GitHub data can still be
# connected with a personal access token).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
